# Google OAuth (Better Auth social sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Better Auth
BETTER_AUTH_SECRET=""
# Public URL of the app, for example http://localhost:3000 locally
BETTER_AUTH_URL=""
# API key for the Better Auth infrastructure service (@better-auth/infra)
BETTER_AUTH_API_KEY=""

# Base URLs used in auth redirects and in email links
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_BASE_URL=""

# DeepInfra: idea text and card images
DEEPINFRA_API_KEY=""

# Neon PostgreSQL connection string (also read by the Prisma CLI)
DATABASE_URL=""

# Vercel Blob: avatars and saved card images
BLOB_READ_WRITE_TOKEN=""

# Resend: auth emails
RESEND_API_KEY=""
# Sender, for example "Swiipy <hello@your-domain>". Without it the code falls
# back to Resend's test sender, which only delivers to the Resend account owner.
RESEND_FROM_EMAIL=""

# Public contact address (used in production)
CONTACT_EMAIL_ADDRESS=""
